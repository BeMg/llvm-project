# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=riscv64 -run-pass=new-shrink-wrap -verify-machineinstrs \
# RUN:   %s -o - | FileCheck %s
# The save/restore points are checked separately, as the script above only
# generates checks for the function bodies.
# RUN: llc -mtriple=riscv64 -run-pass=new-shrink-wrap %s -o %t.legacy.mir
# RUN: FileCheck %s --check-prefix=POINTS --input-file=%t.legacy.mir
# RUN: llc -mtriple=riscv64 -passes=new-shrink-wrap %s -o %t.npm.mir
# RUN: FileCheck %s --check-prefix=POINTS --input-file=%t.npm.mir

# Test the changes NewShrinkWrap makes so that fewer blocks need the frame,
# and the restore point of regions that never return.

# forward_return: bb.1 computes the return value in s0 only for bb.3 to copy
# it to a0. It computes it in a0 instead, and branches to bb.4, the part of
# bb.3 after the copy. The prologue then goes in bb.2. bb.2 is not forwarded:
# its value comes from a call.
# POINTS-LABEL: name: forward_return
# POINTS:       savePoint:
# POINTS-NEXT:    - point: '%bb.2'
# POINTS:       restorePoint:
# POINTS-NEXT:    - point: '%bb.3'

# sink_csr_def: bb.1 needs the frame only to copy the argument to s0, which is
# live into bb.2 only. The copy is moved to the start of bb.2, where the
# prologue then goes, and bb.1 reads the argument instead of s0.
# POINTS-LABEL: name: sink_csr_def
# POINTS:       savePoint:
# POINTS-NEXT:    - point: '%bb.2'
# POINTS:       restorePoint:
# POINTS-NEXT:    - point: '%bb.4'

# sink_csr_def_no_gain: the same, but the other successor of bb.1, bb.6, needs
# the frame too. Moving the copy would not move the prologue down, so bb.1 is
# unchanged.
# POINTS-LABEL: name: sink_csr_def_no_gain
# POINTS-NOT:   savePoint:
# POINTS:       csrSavePoints:

# noreturn_paths: bb.2 needs the frame and leads to two blocks calling
# noreturn functions, so the blocks needing the frame have no common
# post-dominator. As no return is reachable from bb.2, the epilogue is not
# needed: the restore point is one of the blocks without successors, in which
# PEI emits no epilogue.
# POINTS-LABEL: name: noreturn_paths
# POINTS:       savePoint:
# POINTS-NEXT:    - point: '%bb.2'
# POINTS:       restorePoint:
# POINTS-NEXT:    - point: '%bb.4'

# sink_copy_redef: like sink_csr_def, but bb.1 then overwrites the source of
# the copy to s0, a0. The copy is moved to bb.2, and the load in bb.1 writes
# a free register instead of a0, so that a0 still holds the argument at the
# end of bb.1. No instruction is added.
# POINTS-LABEL: name: sink_copy_redef
# POINTS:       savePoint:
# POINTS-NEXT:    - point: '%bb.2'

# sink_copy_redef_live_out: the same, but the value loaded to a0 is live into
# bb.3, so a0 cannot hold the argument. The copy is done to a free register.
# POINTS-LABEL: name: sink_copy_redef_live_out
# POINTS:       savePoint:
# POINTS-NEXT:    - point: '%bb.2'

# sink_def_not_copy: the def of s0 in bb.1 is not a copy, so it is done to a
# free register, and copied to s0 at the start of bb.2.
# POINTS-LABEL: name: sink_def_not_copy
# POINTS:       savePoint:
# POINTS-NEXT:    - point: '%bb.2'

# forward_return_in_frame: like forward_return, but the entry block calls a
# function, so bb.1 runs with the frame anyway. Its return value is not
# forwarded, which would only add a branch, and bb.3 is not split.
# POINTS-LABEL: name: forward_return_in_frame
# POINTS-NOT:   savePoint:

--- |
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "riscv64"

  declare i64 @f(i64)

  declare void @g(i64)

  ; Function Attrs: noreturn
  declare void @die(i64, i64) #0

  ; Function Attrs: noreturn
  declare void @die2(i64) #0

  ; Function Attrs: nounwind
  define i64 @forward_return(i64 %a) #1 {
  entry:
    %c = icmp eq i64 %a, 0
    br i1 %c, label %ret, label %call

  call:                                             ; preds = %entry
    %x = call i64 @f(i64 %a)
    call void @g(i64 %x)
    br label %ret

  ret:                                              ; preds = %call, %entry
    %r = phi i64 [ 7, %entry ], [ %x, %call ]
    ret i64 %r
  }

  ; Function Attrs: nounwind
  define i64 @sink_csr_def(ptr %p, ptr %q) #1 {
  entry:
    %c0 = icmp eq ptr %p, null
    br i1 %c0, label %exit, label %load

  load:                                             ; preds = %entry
    %v = load i8, ptr %p, align 1
    %c = icmp eq i8 %v, 0
    br i1 %c, label %exit, label %loop.preheader

  loop.preheader:                                   ; preds = %load
    br label %loop

  loop:                                             ; preds = %loop.preheader, %loop
    %i = phi ptr [ %n, %loop ], [ %p, %loop.preheader ]
    %w = load i8, ptr %i, align 1
    %n = getelementptr i8, ptr %i, i64 1
    %d = icmp eq i8 %w, 0
    br i1 %d, label %call, label %loop

  call:                                             ; preds = %loop
    %z = ptrtoint ptr %n to i64
    %x = call i64 @f(i64 %z)
    %pp = ptrtoint ptr %p to i64
    call void @g(i64 %pp)
    ret i64 %x

  exit:                                             ; preds = %load, %entry
    ret i64 0
  }

  ; Function Attrs: nounwind
  define i64 @sink_csr_def_no_gain(ptr %p, ptr %q) #1 {
  entry:
    %c0 = icmp eq ptr %p, null
    br i1 %c0, label %exit, label %load

  load:                                             ; preds = %entry
    %v = load i8, ptr %p, align 1
    %c = icmp eq i8 %v, 0
    br i1 %c, label %exit, label %loop.preheader

  loop.preheader:                                   ; preds = %load
    br label %loop

  loop:                                             ; preds = %loop.preheader, %loop
    %i = phi ptr [ %n, %loop ], [ %p, %loop.preheader ]
    %w = load i8, ptr %i, align 1
    %n = getelementptr i8, ptr %i, i64 1
    %d = icmp eq i8 %w, 0
    br i1 %d, label %call, label %loop

  call:                                             ; preds = %loop
    %z = ptrtoint ptr %n to i64
    %x = call i64 @f(i64 %z)
    %pp = ptrtoint ptr %p to i64
    call void @g(i64 %pp)
    ret i64 %x

  exit:                                             ; preds = %load, %entry
    call void @g(i64 0)
    ret i64 0
  }

  ; Function Attrs: nounwind
  define void @noreturn_paths(i64 %a, i64 %b) #1 {
  entry:
    %c = icmp eq i64 %a, %b
    br i1 %c, label %ok, label %fail

  ok:                                               ; preds = %entry
    tail call void @g(i64 %a)
    ret void

  fail:                                             ; preds = %entry
    %x = call i64 @f(i64 %a)
    %d = icmp eq i64 %x, 0
    br i1 %d, label %abort1, label %abort2

  abort1:                                           ; preds = %fail
    call void @die(i64 %x, i64 %b)
    unreachable

  abort2:                                           ; preds = %fail
    call void @die2(i64 %b)
    unreachable
  }

  ; Function Attrs: nounwind
  define i64 @sink_copy_redef(i64 %a, ptr %q) #1 {
  entry:
    %c0 = icmp eq i64 %a, 0
    br i1 %c0, label %exit, label %load

  load:                                             ; preds = %entry
    %v = load i8, ptr %q, align 1
    %c = icmp eq i8 %v, 0
    br i1 %c, label %exit, label %call

  call:                                             ; preds = %load
    %x = call i64 @f(i64 %a)
    call void @g(i64 %a)
    ret i64 %x

  exit:                                             ; preds = %load, %entry
    ret i64 0
  }

  ; Function Attrs: nounwind
  define i64 @sink_copy_redef_live_out(i64 %a, ptr %q) #1 {
  entry:
    %c0 = icmp eq i64 %a, 0
    br i1 %c0, label %exit, label %load

  load:                                             ; preds = %entry
    %v = load i8, ptr %q, align 1
    %c = icmp eq i8 %v, 0
    br i1 %c, label %exit, label %call

  call:                                             ; preds = %load
    %x = call i64 @f(i64 %a)
    call void @g(i64 %a)
    ret i64 %x

  exit:                                             ; preds = %load, %entry
    ret i64 0
  }

  ; Function Attrs: nounwind
  define i64 @sink_def_not_copy(i64 %a, ptr %q) #1 {
  entry:
    %c0 = icmp eq i64 %a, 0
    br i1 %c0, label %exit, label %load

  load:                                             ; preds = %entry
    %v = load i8, ptr %q, align 1
    %c = icmp eq i8 %v, 0
    br i1 %c, label %exit, label %call

  call:                                             ; preds = %load
    %x = call i64 @f(i64 %a)
    call void @g(i64 %a)
    ret i64 %x

  exit:                                             ; preds = %load, %entry
    ret i64 0
  }

  ; Function Attrs: nounwind
  define i64 @forward_return_in_frame(i64 %a) #1 {
  entry:
    call void @g(i64 %a)
    %c = icmp eq i64 %a, 0
    br i1 %c, label %ret, label %call

  call:                                             ; preds = %entry
    %x = call i64 @f(i64 %a)
    br label %ret

  ret:                                              ; preds = %call, %entry
    %r = phi i64 [ 7, %entry ], [ %x, %call ]
    ret i64 %r
  }

  attributes #0 = { noreturn }
  attributes #1 = { nounwind }
...
---
name:            forward_return
alignment:       4
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
tracksDebugUserValues: true
liveins:
  - { reg: '$x10' }
frameInfo:
  maxAlignment:    1
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  maxCallFrameSize: 0
machineFunctionInfo:
  varArgsFrameIndex: 0
  varArgsSaveSize: 0
body:             |
  ; CHECK-LABEL: name: forward_return
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x30000000), %bb.2(0x50000000)
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BNE renamable $x10, $x0, %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = ADDI $x0, 7
  ; CHECK-NEXT:   PseudoBR %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.call:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   renamable $x8 = COPY $x10
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @g, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.ret:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT:   liveins: $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = COPY killed renamable $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4.ret:
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0.entry:
    successors: %bb.1(0x30000000), %bb.2(0x50000000)
    liveins: $x10

    BNE renamable $x10, $x0, %bb.2

  bb.1:
    renamable $x8 = ADDI $x0, 7
    PseudoBR %bb.3

  bb.2.call:
    liveins: $x10

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x8 = COPY $x10
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @g, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2

  bb.3.ret:
    liveins: $x8

    $x10 = COPY killed renamable $x8
    PseudoRET implicit $x10
...
---
name:            sink_csr_def
alignment:       4
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
tracksDebugUserValues: true
liveins:
  - { reg: '$x10' }
frameInfo:
  maxAlignment:    1
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  maxCallFrameSize: 0
machineFunctionInfo:
  varArgsFrameIndex: 0
  varArgsSaveSize: 0
body:             |
  ; CHECK-LABEL: name: sink_csr_def
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.5(0x30000000), %bb.1(0x50000000)
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BEQ renamable $x10, $x0, %bb.5
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.load:
  ; CHECK-NEXT:   successors: %bb.5(0x30000000), %bb.2(0x50000000)
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x11 = LBU renamable $x10, 0 :: (load (s8) from %ir.p)
  ; CHECK-NEXT:   BEQ killed renamable $x11, $x0, %bb.5
  ; CHECK-NEXT:   PseudoBR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.loop.preheader:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x8 = COPY $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.loop:
  ; CHECK-NEXT:   successors: %bb.4(0x04000000), %bb.3(0x7c000000)
  ; CHECK-NEXT:   liveins: $x8, $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x11 = LBU renamable $x10, 0 :: (load (s8) from %ir.i)
  ; CHECK-NEXT:   renamable $x10 = ADDI killed renamable $x10, 1
  ; CHECK-NEXT:   BNE killed renamable $x11, $x0, %bb.3
  ; CHECK-NEXT:   PseudoBR %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4.call:
  ; CHECK-NEXT:   liveins: $x8, $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   renamable $x9 = COPY $x10
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   $x10 = COPY killed renamable $x8
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @g, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   $x10 = COPY killed renamable $x9
  ; CHECK-NEXT:   PseudoRET implicit $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5.exit:
  ; CHECK-NEXT:   $x10 = COPY $x0
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0.entry:
    successors: %bb.5(0x30000000), %bb.1(0x50000000)
    liveins: $x10

    BEQ renamable $x10, $x0, %bb.5
    PseudoBR %bb.1

  bb.1.load:
    successors: %bb.5(0x30000000), %bb.2(0x50000000)
    liveins: $x10

    renamable $x8 = COPY $x10
    renamable $x11 = LBU renamable $x8, 0 :: (load (s8) from %ir.p)
    BEQ killed renamable $x11, $x0, %bb.5
    PseudoBR %bb.2

  bb.2.loop.preheader:
    liveins: $x8, $x10


  bb.3.loop:
    successors: %bb.4(0x04000000), %bb.3(0x7c000000)
    liveins: $x8, $x10

    renamable $x11 = LBU renamable $x10, 0 :: (load (s8) from %ir.i)
    renamable $x10 = ADDI killed renamable $x10, 1
    BNE killed renamable $x11, $x0, %bb.3
    PseudoBR %bb.4

  bb.4.call:
    liveins: $x8, $x10

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x9 = COPY $x10
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY killed renamable $x8
    PseudoCALL target-flags(riscv-call) @g, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY killed renamable $x9
    PseudoRET implicit $x10

  bb.5.exit:
    $x10 = COPY $x0
    PseudoRET implicit $x10
...
