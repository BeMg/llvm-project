# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=riscv64 -riscv-use-new-shrink-wrap=true -run-pass=riscv-shrink-wrap -verify-machineinstrs \
# RUN:   %s -o - | FileCheck %s
# The save and restore points are checked separately, because the script above
# only generates checks for the function bodies.
# RUN: llc -mtriple=riscv64 -riscv-use-new-shrink-wrap=true -run-pass=riscv-shrink-wrap %s -o %t.legacy.mir
# RUN: FileCheck %s --check-prefix=POINTS --input-file=%t.legacy.mir
# RUN: llc -mtriple=riscv64 -riscv-use-new-shrink-wrap=true -run-pass=riscv-shrink-wrap \
# RUN:   -riscv-shrink-wrap-separate=false %s -o %t.nosep.mir
# RUN: FileCheck %s --check-prefix=NOSEP --input-file=%t.nosep.mir

# Test the CSR save and restore points of separate shrink-wrapping.

# separate: the prologue stays in the entry block, s1 and s2 are only saved and
# restored in bb.2, the only block using them.
# POINTS-LABEL: name: separate
# POINTS-NOT:   savePoint:
# POINTS:       csrSavePoints:
# POINTS-NEXT:    - point: '%bb.2'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x18'
# POINTS-NEXT:        - '$x9'
# POINTS-NEXT:  csrRestorePoints:
# POINTS-NEXT:    - point: '%bb.2'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x18'
# POINTS-NEXT:        - '$x9'
# NOSEP-LABEL:  name: separate
# NOSEP-NOT:    csrSavePoints:
# NOSEP:        body:

# loop_preheader: the cold block in the loop uses s1. The preheader runs once
# for each entry into the loop, so it saves s1. The loop exit restores it.
# POINTS-LABEL: name: loop_preheader
# POINTS:       csrSavePoints:
# POINTS-NEXT:    - point: '%bb.2'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x9'
# POINTS-NEXT:  csrRestorePoints:
# POINTS-NEXT:    - point: '%bb.6'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x9'

# loop_no_preheader: as above, but the entry branches directly to the loop
# header. The pass splits the edge into the loop header with bb.7, which saves
# s1. The loop exit restores it.
# POINTS-LABEL: name: loop_no_preheader
# POINTS:       csrSavePoints:
# POINTS-NEXT:    - point: '%bb.7'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x9'
# POINTS-NEXT:  csrRestorePoints:
# POINTS-NEXT:    - point: '%bb.5'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x9'

# separate_split_edge: s0 is saved in bb.2, and restored on the split edge
# bb.2 -> bb.3 (bb.5) and at the end of bb.3 (s2).
# POINTS-LABEL: name: separate_split_edge
# POINTS:       csrSavePoints:
# POINTS-NEXT:    - point: '%bb.2'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x8'
# POINTS-NEXT:  csrRestorePoints:
# POINTS-NEXT:    - point: '%bb.3'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x8'
# POINTS-NEXT:    - point: '%bb.5'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x8'

# separate_critical_edge: like separate_split_edge, but the edge bb.1 -> bb.2
# is critical. The pass splits it with bb.4 to restore s0 there.
# POINTS-LABEL: name: separate_critical_edge
# POINTS:       csrSavePoints:
# POINTS-NEXT:    - point: '%bb.1'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x8'
# POINTS-NEXT:  csrRestorePoints:
# POINTS-NEXT:    - point: '%bb.3'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x8'
# POINTS-NEXT:    - point: '%bb.4'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x8'

--- |
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "riscv64"

  declare i32 @f(i32)

  define i32 @separate(i32 %x, i32 %y) {
  entry:
    %c = icmp eq i32 %x, 0
    br i1 %c, label %a, label %b

  a:                                                ; preds = %entry
    %r1 = call i32 @f(i32 %y)
    br label %ret

  b:                                                ; preds = %entry
    %r2 = call i32 @f(i32 %x)
    %r3 = call i32 @f(i32 %y)
    %r4 = call i32 @f(i32 %r2)
    %s = add i32 %r3, %r4
    %s2 = add i32 %s, %y
    br label %ret

  ret:                                              ; preds = %b, %a
    %p = phi i32 [ %r1, %a ], [ %s2, %b ]
    ret i32 %p
  }

  define i32 @loop_preheader(i32 %x, i32 %y) {
  entry:
    %c = icmp eq i32 %x, 0
    br i1 %c, label %preheader, label %fast

  fast:
    %r0 = call i32 @f(i32 %y)
    br label %ret

  preheader:
    br label %loop

  loop:
    %i = phi i32 [ %y, %preheader ], [ %i2, %latch ]
    %c1 = icmp eq i32 %i, 0
    br i1 %c1, label %latch, label %cold

  cold:
    %r = call i32 @f(i32 %i)
    %a = add i32 %i, 1
    %s = add i32 %a, %r
    br label %latch

  latch:
    %i2 = phi i32 [ %i, %loop ], [ %s, %cold ]
    %c2 = icmp ne i32 %i2, 0
    br i1 %c2, label %loop, label %exit

  exit:
    br label %ret

  ret:
    %p = phi i32 [ %r0, %fast ], [ %i2, %exit ]
    ret i32 %p
  }

  define i32 @loop_no_preheader(i32 %x, i32 %y) {
  entry:
    %c = icmp eq i32 %x, 0
    br i1 %c, label %loop, label %fast

  fast:
    %r0 = call i32 @f(i32 %y)
    br label %ret

  loop:
    %i = phi i32 [ %y, %entry ], [ %i2, %latch ]
    %c1 = icmp eq i32 %i, 0
    br i1 %c1, label %latch, label %cold

  cold:
    %r = call i32 @f(i32 %i)
    %a = add i32 %i, 1
    %s = add i32 %a, %r
    br label %latch

  latch:
    %i2 = phi i32 [ %i, %loop ], [ %s, %cold ]
    %c2 = icmp ne i32 %i2, 0
    br i1 %c2, label %loop, label %exit

  exit:
    br label %ret

  ret:
    %p = phi i32 [ %r0, %fast ], [ %i2, %exit ]
    ret i32 %p
  }

  define i32 @separate_split_edge(i32 %x, i32 %y) {
  entry:
    %c = icmp eq i32 %x, 0
    br i1 %c, label %s1, label %p

  p:                                                ; preds = %entry
    %r = call i32 @f(i32 %x)
    %c2 = icmp eq i32 %r, 0
    br i1 %c2, label %s1, label %s2

  s1:                                               ; preds = %p, %entry
    %v = phi i32 [ %x, %entry ], [ %r, %p ]
    %r1 = call i32 @f(i32 %v)
    ret i32 %r1

  s2:                                               ; preds = %p
    %r2 = call i32 @f(i32 %r)
    %s = add i32 %r2, %y
    ret i32 %s
  }

  define i32 @separate_critical_edge(i32 %x, i32 %y) {
  entry:
    %c = icmp eq i32 %x, 0
    br i1 %c, label %s1, label %p

  p:                                                ; preds = %entry
    %r = call i32 @f(i32 %x)
    %c2 = icmp eq i32 %r, 0
    br i1 %c2, label %s1, label %s2

  s1:                                               ; preds = %p, %entry
    %v = phi i32 [ %x, %entry ], [ %r, %p ]
    %r1 = call i32 @f(i32 %v)
    ret i32 %r1

  s2:                                               ; preds = %p
    %r2 = call i32 @f(i32 %r)
    %s = add i32 %r2, %y
    ret i32 %s
  }
...
---
name:            separate
alignment:       4
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: true
registers:       []
liveins:
  - { reg: '$x10', virtual-reg: '' }
  - { reg: '$x11', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  varArgsFrameIndex: 0
  varArgsSaveSize: 0
body:             |
  ; CHECK-LABEL: name: separate
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x30000000), %bb.2(0x50000000)
  ; CHECK-NEXT:   liveins: $x10, $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x12 = ADDIW renamable $x10, 0
  ; CHECK-NEXT:   renamable $x8 = COPY $x11
  ; CHECK-NEXT:   BNE killed renamable $x12, $x0, %bb.2
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.a:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   $x10 = COPY killed renamable $x8
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoBR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.b:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x8, $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   renamable $x9 = COPY $x10
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   $x10 = COPY renamable $x8
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   renamable $x18 = COPY $x10
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   $x10 = COPY killed renamable $x9
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   renamable $x8 = ADD killed renamable $x18, killed renamable $x8
  ; CHECK-NEXT:   renamable $x10 = ADDW killed renamable $x8, killed renamable $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.ret:
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0.entry:
    successors: %bb.1(0x30000000), %bb.2(0x50000000)
    liveins: $x10, $x11

    renamable $x12 = ADDIW renamable $x10, 0
    renamable $x8 = COPY $x11
    BNE killed renamable $x12, $x0, %bb.2
    PseudoBR %bb.1

  bb.1.a:
    successors: %bb.3(0x80000000)
    liveins: $x8

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY killed renamable $x8
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    PseudoBR %bb.3

  bb.2.b:
    successors: %bb.3(0x80000000)
    liveins: $x8, $x10

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x9 = COPY $x10
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY renamable $x8
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x18 = COPY $x10
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY killed renamable $x9
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x8 = ADD killed renamable $x18, killed renamable $x8
    renamable $x10 = ADDW killed renamable $x8, killed renamable $x10

  bb.3.ret:
    liveins: $x10

    PseudoRET implicit $x10
...
---
name:            loop_preheader
alignment:       1
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: false
registers:       []
liveins:
  - { reg: '$x10', virtual-reg: '' }
  - { reg: '$x11', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  varArgsFrameIndex: 0
  varArgsSaveSize: 0
body:             |
  ; CHECK-LABEL: name: loop_preheader
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x7ff00000), %bb.2(0x00100000)
  ; CHECK-NEXT:   liveins: $x10, $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x8 = COPY $x11
  ; CHECK-NEXT:   BEQ killed renamable $x10, $x0, %bb.2
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.fast:
  ; CHECK-NEXT:   successors: %bb.7(0x80000000)
  ; CHECK-NEXT:   liveins: $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = COPY killed renamable $x8
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoBR %bb.7
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.preheader:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoBR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.loop:
  ; CHECK-NEXT:   successors: %bb.4(0x40000000), %bb.5(0x40000000)
  ; CHECK-NEXT:   liveins: $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BEQ renamable $x8, $x0, %bb.5
  ; CHECK-NEXT:   PseudoBR %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4.cold:
  ; CHECK-NEXT:   successors: %bb.5(0x80000000)
  ; CHECK-NEXT:   liveins: $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x9 = ADDI renamable $x8, 1
  ; CHECK-NEXT:   $x10 = COPY killed renamable $x8
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   renamable $x8 = ADD killed renamable $x9, killed renamable $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5.latch:
  ; CHECK-NEXT:   successors: %bb.3(0x73333333), %bb.6(0x0ccccccd)
  ; CHECK-NEXT:   liveins: $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BNE renamable $x8, $x0, %bb.3
  ; CHECK-NEXT:   PseudoBR %bb.6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.6.exit:
  ; CHECK-NEXT:   successors: %bb.7(0x80000000)
  ; CHECK-NEXT:   liveins: $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = COPY killed renamable $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.7.ret:
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0.entry:
    successors: %bb.1(0x7ff00000), %bb.2(0x00100000)
    liveins: $x10, $x11

    renamable $x8 = COPY $x11
    BEQ killed renamable $x10, $x0, %bb.2
    PseudoBR %bb.1

  bb.1.fast:
    successors: %bb.7(0x80000000)
    liveins: $x8

    $x10 = COPY killed renamable $x8
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    PseudoBR %bb.7

  bb.2.preheader:
    successors: %bb.3(0x80000000)
    liveins: $x8

    PseudoBR %bb.3

  bb.3.loop:
    successors: %bb.4(0x40000000), %bb.5(0x40000000)
    liveins: $x8

    BEQ renamable $x8, $x0, %bb.5
    PseudoBR %bb.4

  bb.4.cold:
    successors: %bb.5(0x80000000)
    liveins: $x8

    renamable $x9 = ADDI renamable $x8, 1
    $x10 = COPY killed renamable $x8
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x8 = ADD killed renamable $x9, killed renamable $x10

  bb.5.latch:
    successors: %bb.3(0x73333333), %bb.6(0x0ccccccd)
    liveins: $x8

    BNE renamable $x8, $x0, %bb.3
    PseudoBR %bb.6

  bb.6.exit:
    successors: %bb.7(0x80000000)
    liveins: $x8

    $x10 = COPY killed renamable $x8

  bb.7.ret:
    liveins: $x10

    PseudoRET implicit $x10
...
---
name:            loop_no_preheader
alignment:       1
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: false
registers:       []
liveins:
  - { reg: '$x10', virtual-reg: '' }
  - { reg: '$x11', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  varArgsFrameIndex: 0
  varArgsSaveSize: 0
body:             |
  ; CHECK-LABEL: name: loop_no_preheader
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x7ff00000), %bb.7(0x00100000)
  ; CHECK-NEXT:   liveins: $x10, $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x8 = COPY $x11
  ; CHECK-NEXT:   BNE killed renamable $x10, $x0, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.7:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoBR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.fast:
  ; CHECK-NEXT:   successors: %bb.6(0x80000000)
  ; CHECK-NEXT:   liveins: $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = COPY killed renamable $x8
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoBR %bb.6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.loop:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT:   liveins: $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BEQ renamable $x8, $x0, %bb.4
  ; CHECK-NEXT:   PseudoBR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.cold:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT:   liveins: $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x9 = ADDI renamable $x8, 1
  ; CHECK-NEXT:   $x10 = COPY killed renamable $x8
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   renamable $x8 = ADD killed renamable $x9, killed renamable $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4.latch:
  ; CHECK-NEXT:   successors: %bb.2(0x73333333), %bb.5(0x0ccccccd)
  ; CHECK-NEXT:   liveins: $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BNE renamable $x8, $x0, %bb.2
  ; CHECK-NEXT:   PseudoBR %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5.exit:
  ; CHECK-NEXT:   successors: %bb.6(0x80000000)
  ; CHECK-NEXT:   liveins: $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = COPY killed renamable $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.6.ret:
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0.entry:
    successors: %bb.1(0x7ff00000), %bb.2(0x00100000)
    liveins: $x10, $x11

    renamable $x8 = COPY $x11
    BEQ killed renamable $x10, $x0, %bb.2
    PseudoBR %bb.1

  bb.1.fast:
    successors: %bb.6(0x80000000)
    liveins: $x8

    $x10 = COPY killed renamable $x8
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    PseudoBR %bb.6

  bb.2.loop:
    successors: %bb.3(0x40000000), %bb.4(0x40000000)
    liveins: $x8

    BEQ renamable $x8, $x0, %bb.4
    PseudoBR %bb.3

  bb.3.cold:
    successors: %bb.4(0x80000000)
    liveins: $x8

    renamable $x9 = ADDI renamable $x8, 1
    $x10 = COPY killed renamable $x8
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x8 = ADD killed renamable $x9, killed renamable $x10

  bb.4.latch:
    successors: %bb.2(0x73333333), %bb.5(0x0ccccccd)
    liveins: $x8

    BNE renamable $x8, $x0, %bb.2
    PseudoBR %bb.5

  bb.5.exit:
    successors: %bb.6(0x80000000)
    liveins: $x8

    $x10 = COPY killed renamable $x8

  bb.6.ret:
    liveins: $x10

    PseudoRET implicit $x10
...
---
name:            separate_split_edge
alignment:       4
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         true
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: true
registers:       []
liveins:
  - { reg: '$x10', virtual-reg: '' }
  - { reg: '$x11', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  varArgsFrameIndex: 0
  varArgsSaveSize: 0
body:             |
  ; CHECK-LABEL: name: separate_split_edge
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x30000000), %bb.2(0x50000000)
  ; CHECK-NEXT:   liveins: $x10, $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x12 = ADDIW renamable $x10, 0
  ; CHECK-NEXT:   BNE killed renamable $x12, $x0, %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoBR %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.p:
  ; CHECK-NEXT:   successors: %bb.3(0x30000000), %bb.5(0x50000000)
  ; CHECK-NEXT:   liveins: $x10, $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x8 = COPY $x11
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   renamable $x11 = ADDIW renamable $x10, 0
  ; CHECK-NEXT:   BNE killed renamable $x11, $x0, %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4.s1:
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoRET implicit $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5.s2:
  ; CHECK-NEXT:   liveins: $x8, $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   renamable $x10 = ADDW killed renamable $x10, killed renamable $x8
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0.entry:
    successors: %bb.4(0x30000000), %bb.1(0x50000000)
    liveins: $x10, $x11

    renamable $x12 = ADDIW renamable $x10, 0
    BNE killed renamable $x12, $x0, %bb.1

  bb.4:
    successors: %bb.2(0x80000000)
    liveins: $x10

    PseudoBR %bb.2

  bb.1.p:
    successors: %bb.5(0x30000000), %bb.3(0x50000000)
    liveins: $x10, $x11

    renamable $x8 = COPY $x11
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x11 = ADDIW renamable $x10, 0
    BNE killed renamable $x11, $x0, %bb.3

  bb.5:
    successors: %bb.2(0x80000000)
    liveins: $x10

  bb.2.s1:
    liveins: $x10

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    PseudoRET implicit $x10

  bb.3.s2:
    liveins: $x8, $x10

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x10 = ADDW killed renamable $x10, killed renamable $x8
    PseudoRET implicit $x10
...
---
name:            separate_critical_edge
alignment:       4
tracksRegLiveness: true
noVRegs:         true
liveins:
  - { reg: '$x10', virtual-reg: '' }
  - { reg: '$x11', virtual-reg: '' }
frameInfo:
  adjustsStack:    true
  hasCalls:        true
body:             |
  ; CHECK-LABEL: name: separate_critical_edge
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.2(0x30000000), %bb.1(0x50000000)
  ; CHECK-NEXT:   liveins: $x10, $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x12 = ADDIW renamable $x10, 0
  ; CHECK-NEXT:   BEQ killed renamable $x12, $x0, %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.p:
  ; CHECK-NEXT:   successors: %bb.4(0x30000000), %bb.3(0x50000000)
  ; CHECK-NEXT:   liveins: $x10, $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x8 = COPY $x11
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   renamable $x11 = ADDIW renamable $x10, 0
  ; CHECK-NEXT:   BNE killed renamable $x11, $x0, %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.s1:
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoRET implicit $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.s2:
  ; CHECK-NEXT:   liveins: $x8, $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   renamable $x10 = ADDW killed renamable $x10, killed renamable $x8
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0.entry:
    successors: %bb.2(0x30000000), %bb.1(0x50000000)
    liveins: $x10, $x11

    renamable $x12 = ADDIW renamable $x10, 0
    BEQ killed renamable $x12, $x0, %bb.2

  bb.1.p:
    successors: %bb.2(0x30000000), %bb.3(0x50000000)
    liveins: $x10, $x11

    renamable $x8 = COPY $x11
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x11 = ADDIW renamable $x10, 0
    BNE killed renamable $x11, $x0, %bb.3

  bb.2.s1:
    liveins: $x10

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    PseudoRET implicit $x10

  bb.3.s2:
    liveins: $x8, $x10

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x10 = ADDW killed renamable $x10, killed renamable $x8
    PseudoRET implicit $x10
...
