; NEW-NEXT:  .LBB1_2: # %body
; NEW-NEXT:    # =>This Inner Loop Header: Depth=1
; NEW-NEXT:    call g
; NEW-NEXT:    lw a0, 16(zero)
; NEW-NEXT:    bnez a0, .LBB1_2
