; OLD-NEXT:    beqz a0, .LBB1_2
; OLD-NEXT:  .LBB1_1: # %body
; OLD-NEXT:    # =>This Inner Loop Header: Depth=1
; OLD-NEXT:    call g
; OLD-NEXT:    lw a0, 16(zero)
; OLD-NEXT:    bnez a0, .LBB1_1
