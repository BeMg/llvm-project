# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=riscv64 -run-pass=prolog-epilog -verify-machineinstrs %s \
# RUN:   -o - | FileCheck %s

# Test the saves and restores of callee-saved registers that are shrink-wrapped
# separately (csrSavePoints and csrRestorePoints).

# separate: x9 and x18 are saved at the start of bb.2 and restored at its end.
# The prologue and epilogue save and restore only x1 and x8. The CFI of each
# save and restore follows it.

# separate_optsize: RISC-V does not shrink-wrap registers separately when
# optimizing for size, so the prologue and epilogue save and restore all
# registers.

--- |
  declare i32 @f(i32)

  define i32 @separate(i32 %x, i32 %y) {
  entry:
    %c = icmp eq i32 %x, 0
    br i1 %c, label %a, label %b

  a:
    %r1 = call i32 @f(i32 %y)
    br label %ret

  b:
    %r2 = call i32 @f(i32 %x)
    %r3 = call i32 @f(i32 %y)
    %r4 = call i32 @f(i32 %r2)
    %s = add i32 %r3, %r4
    %s2 = add i32 %s, %y
    br label %ret

  ret:
    %p = phi i32 [ %r1, %a ], [ %s2, %b ]
    ret i32 %p
  }

  define i32 @separate_optsize(i32 %x, i32 %y) optsize {
  entry:
    %c = icmp eq i32 %x, 0
    br i1 %c, label %a, label %b

  a:
    %r1 = call i32 @f(i32 %y)
    br label %ret

  b:
    %r2 = call i32 @f(i32 %x)
    %r3 = call i32 @f(i32 %y)
    %r4 = call i32 @f(i32 %r2)
    %s = add i32 %r3, %r4
    %s2 = add i32 %s, %y
    br label %ret

  ret:
    %p = phi i32 [ %r1, %a ], [ %s2, %b ]
    ret i32 %p
  }
...
---
name:            separate
tracksRegLiveness: true
noVRegs:         true
liveins:
  - { reg: '$x10', virtual-reg: '' }
  - { reg: '$x11', virtual-reg: '' }
frameInfo:
  adjustsStack:    true
  hasCalls:        true
  csrSavePoints:
    - point:           '%bb.2'
      registers:
        - '$x9'
        - '$x18'
  csrRestorePoints:
    - point:           '%bb.2'
      registers:
        - '$x9'
        - '$x18'
body:             |
  ; CHECK-LABEL: name: separate
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x30000000), %bb.2(0x50000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x1, $x8, $x9, $x18
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x2 = frame-setup ADDI $x2, -32
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION def_cfa_offset 32
  ; CHECK-NEXT:   frame-setup SD killed $x1, $x2, 24 :: (store (s64) into %stack.0)
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION offset $x1, -8
  ; CHECK-NEXT:   frame-setup SD killed $x8, $x2, 16 :: (store (s64) into %stack.1)
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION offset $x8, -16
  ; CHECK-NEXT:   renamable $x12 = ADDIW renamable $x10, 0
  ; CHECK-NEXT:   renamable $x8 = COPY $x11
  ; CHECK-NEXT:   BNE killed renamable $x12, $x0, %bb.2
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.a:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x8, $x9, $x18
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = COPY killed renamable $x8
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   PseudoBR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.b:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x8, $x10, $x9, $x18
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   frame-setup SD killed $x9, $x2, 8 :: (store (s64) into %stack.2)
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION offset $x9, -24
  ; CHECK-NEXT:   frame-setup SD killed $x18, $x2, 0 :: (store (s64) into %stack.3)
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION offset $x18, -32
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   renamable $x9 = COPY $x10
  ; CHECK-NEXT:   $x10 = COPY renamable $x8
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   renamable $x18 = COPY $x10
  ; CHECK-NEXT:   $x10 = COPY killed renamable $x9
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   renamable $x8 = ADD killed renamable $x18, killed renamable $x8
  ; CHECK-NEXT:   renamable $x10 = ADDW killed renamable $x8, killed renamable $x10
  ; CHECK-NEXT:   $x9 = frame-destroy LD $x2, 8 :: (load (s64) from %stack.2)
  ; CHECK-NEXT:   frame-destroy CFI_INSTRUCTION restore $x9
  ; CHECK-NEXT:   $x18 = frame-destroy LD $x2, 0 :: (load (s64) from %stack.3)
  ; CHECK-NEXT:   frame-destroy CFI_INSTRUCTION restore $x18
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.ret:
  ; CHECK-NEXT:   liveins: $x10, $x9, $x18
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x1 = frame-destroy LD $x2, 24 :: (load (s64) from %stack.0)
  ; CHECK-NEXT:   frame-destroy CFI_INSTRUCTION restore $x1
  ; CHECK-NEXT:   $x8 = frame-destroy LD $x2, 16 :: (load (s64) from %stack.1)
  ; CHECK-NEXT:   frame-destroy CFI_INSTRUCTION restore $x8
  ; CHECK-NEXT:   $x2 = frame-destroy ADDI $x2, 32
  ; CHECK-NEXT:   frame-destroy CFI_INSTRUCTION def_cfa_offset 0
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0.entry:
    successors: %bb.1(0x30000000), %bb.2(0x50000000)
    liveins: $x10, $x11

    renamable $x12 = ADDIW renamable $x10, 0
    renamable $x8 = COPY $x11
    BNE killed renamable $x12, $x0, %bb.2
    PseudoBR %bb.1

  bb.1.a:
    successors: %bb.3(0x80000000)
    liveins: $x8

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY killed renamable $x8
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    PseudoBR %bb.3

  bb.2.b:
    successors: %bb.3(0x80000000)
    liveins: $x8, $x10

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x9 = COPY $x10
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY renamable $x8
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x18 = COPY $x10
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY killed renamable $x9
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x8 = ADD killed renamable $x18, killed renamable $x8
    renamable $x10 = ADDW killed renamable $x8, killed renamable $x10

  bb.3.ret:
    liveins: $x10

    PseudoRET implicit $x10
...
---
name:            separate_optsize
tracksRegLiveness: true
noVRegs:         true
liveins:
  - { reg: '$x10', virtual-reg: '' }
  - { reg: '$x11', virtual-reg: '' }
frameInfo:
  adjustsStack:    true
  hasCalls:        true
  csrSavePoints:
    - point:           '%bb.2'
      registers:
        - '$x9'
        - '$x18'
  csrRestorePoints:
    - point:           '%bb.2'
      registers:
        - '$x9'
        - '$x18'
body:             |
  ; CHECK-LABEL: name: separate_optsize
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x30000000), %bb.2(0x50000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x1, $x8, $x9, $x18
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x2 = frame-setup ADDI $x2, -32
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION def_cfa_offset 32
  ; CHECK-NEXT:   frame-setup SD killed $x1, $x2, 24 :: (store (s64) into %stack.0)
  ; CHECK-NEXT:   frame-setup SD killed $x8, $x2, 16 :: (store (s64) into %stack.1)
  ; CHECK-NEXT:   frame-setup SD killed $x9, $x2, 8 :: (store (s64) into %stack.2)
  ; CHECK-NEXT:   frame-setup SD killed $x18, $x2, 0 :: (store (s64) into %stack.3)
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION offset $x1, -8
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION offset $x8, -16
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION offset $x9, -24
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION offset $x18, -32
  ; CHECK-NEXT:   renamable $x12 = ADDIW renamable $x10, 0
  ; CHECK-NEXT:   renamable $x8 = COPY $x11
  ; CHECK-NEXT:   BNE killed renamable $x12, $x0, %bb.2
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.a:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = COPY killed renamable $x8
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   PseudoBR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.b:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x8, $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   renamable $x9 = COPY $x10
  ; CHECK-NEXT:   $x10 = COPY renamable $x8
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   renamable $x18 = COPY $x10
  ; CHECK-NEXT:   $x10 = COPY killed renamable $x9
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
  ; CHECK-NEXT:   renamable $x8 = ADD killed renamable $x18, killed renamable $x8
  ; CHECK-NEXT:   renamable $x10 = ADDW killed renamable $x8, killed renamable $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.ret:
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x1 = frame-destroy LD $x2, 24 :: (load (s64) from %stack.0)
  ; CHECK-NEXT:   $x8 = frame-destroy LD $x2, 16 :: (load (s64) from %stack.1)
  ; CHECK-NEXT:   $x9 = frame-destroy LD $x2, 8 :: (load (s64) from %stack.2)
  ; CHECK-NEXT:   $x18 = frame-destroy LD $x2, 0 :: (load (s64) from %stack.3)
  ; CHECK-NEXT:   frame-destroy CFI_INSTRUCTION restore $x1
  ; CHECK-NEXT:   frame-destroy CFI_INSTRUCTION restore $x8
  ; CHECK-NEXT:   frame-destroy CFI_INSTRUCTION restore $x9
  ; CHECK-NEXT:   frame-destroy CFI_INSTRUCTION restore $x18
  ; CHECK-NEXT:   $x2 = frame-destroy ADDI $x2, 32
  ; CHECK-NEXT:   frame-destroy CFI_INSTRUCTION def_cfa_offset 0
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0.entry:
    successors: %bb.1(0x30000000), %bb.2(0x50000000)
    liveins: $x10, $x11

    renamable $x12 = ADDIW renamable $x10, 0
    renamable $x8 = COPY $x11
    BNE killed renamable $x12, $x0, %bb.2
    PseudoBR %bb.1

  bb.1.a:
    successors: %bb.3(0x80000000)
    liveins: $x8

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY killed renamable $x8
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    PseudoBR %bb.3

  bb.2.b:
    successors: %bb.3(0x80000000)
    liveins: $x8, $x10

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x9 = COPY $x10
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY renamable $x8
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x18 = COPY $x10
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY killed renamable $x9
    PseudoCALL target-flags(riscv-call) @f, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    renamable $x8 = ADD killed renamable $x18, killed renamable $x8
    renamable $x10 = ADDW killed renamable $x8, killed renamable $x10

  bb.3.ret:
    liveins: $x10

    PseudoRET implicit $x10
...
