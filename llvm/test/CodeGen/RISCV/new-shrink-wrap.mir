body:             |
  ; CHECK-LABEL: name: loop_exit
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoBR %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.header:
  ; CHECK-NEXT:   successors: %bb.3(0x04000000), %bb.2(0x7c000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x10 = LW $x0, 16 :: (volatile load (s32) from `ptr inttoptr (i64 16 to ptr)`)
  ; CHECK-NEXT:   BEQ killed renamable $x10, $x0, %bb.3
  ; CHECK-NEXT:   PseudoBR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.body:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoCALL target-flags(riscv-call) @g, csr_ilp32_lp64, implicit-def dead $x1, implicit-def $x2
  ; CHECK-NEXT:   ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.exit:
  ; CHECK-NEXT:   PseudoRET
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4.header:
  ; CHECK-NEXT:   successors: %bb.5(0x04000000), %bb.6(0x7c000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $x10 = LW $x0, 16 :: (volatile load (s32) from `ptr inttoptr (i64 16 to ptr)`)
  ; CHECK-NEXT:   BNE killed renamable $x10, $x0, %bb.6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5.exit:
  ; CHECK-NEXT:   PseudoRET
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.6.body:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoBR %bb.2
  bb.0.entry:
    successors: %bb.1(0x80000000)

  bb.1.header:
    successors: %bb.3(0x04000000), %bb.2(0x7c000000)

    renamable $x10 = LW $x0, 16 :: (volatile load (s32) from `ptr inttoptr (i64 16 to ptr)`)
    BEQ killed renamable $x10, $x0, %bb.3
    PseudoBR %bb.2

  bb.2.body:
    successors: %bb.1(0x80000000)

    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @g, csr_ilp32_lp64, implicit-def dead $x1, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    PseudoBR %bb.1

  bb.3.exit:
    PseudoRET
...
