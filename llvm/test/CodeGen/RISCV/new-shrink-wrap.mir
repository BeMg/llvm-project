# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=riscv64 -run-pass=new-shrink-wrap -verify-machineinstrs \
# RUN:   %s -o - | FileCheck %s
# The save/restore points are checked separately, as the script above only
# generates checks for the function bodies.
# RUN: llc -mtriple=riscv64 -run-pass=new-shrink-wrap %s -o %t.legacy.mir
# RUN: FileCheck %s --check-prefix=POINTS --input-file=%t.legacy.mir
# RUN: llc -mtriple=riscv64 -passes=new-shrink-wrap %s -o %t.npm.mir
# RUN: FileCheck %s --check-prefix=POINTS --input-file=%t.npm.mir

# Test the placement decisions of the NewShrinkWrap pass.

# loop_exit: bb.1 (header, no frame needed) and bb.3 (exit) are duplicated to
# bb.4 and bb.5 for the path that leaves the loop on the first iteration. The
# prologue goes in the new block bb.6, on the edge from bb.4 into the loop.
# POINTS-LABEL: name: loop_exit
# POINTS:       savePoint:
# POINTS-NEXT:    - point: '%bb.6'
# POINTS:       restorePoint:
# POINTS-NEXT:    - point: '%bb.3'
# POINTS-NOT:   csrSavePoints

# separate: the prologue stays in the entry block, s1 and s2 are only saved and
# restored in bb.2, the only block using them.
# POINTS-LABEL: name: separate
# POINTS-NOT:   savePoint:
# POINTS:       csrSavePoints:
# POINTS-NEXT:    - point: '%bb.2'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x18'
# POINTS-NEXT:        - '$x9'
# POINTS-NEXT:  csrRestorePoints:
# POINTS-NEXT:    - point: '%bb.2'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x18'
# POINTS-NEXT:        - '$x9'

# separate_split_edge: s0 is saved in bb.2, and restored on the split edge
# bb.2 -> bb.3 (bb.5) and at the end of bb.3 (s2).
# POINTS-LABEL: name: separate_split_edge
# POINTS:       csrSavePoints:
# POINTS-NEXT:    - point: '%bb.2'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x8'
# POINTS-NEXT:  csrRestorePoints:
# POINTS-NEXT:    - point: '%bb.3'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x8'
# POINTS-NEXT:    - point: '%bb.5'
# POINTS-NEXT:      registers:
# POINTS-NEXT:        - '$x8'

--- |
  ; ModuleID = '/private/tmp/claude-501/-Users-chenpiyou-workspace-LLVM-Trigger-build-upstream-linux-src-llvm-project/443a2c9d-aacc-445a-8879-2270a60f214d/scratchpad/mir-src.ll'
  source_filename = "/private/tmp/claude-501/-Users-chenpiyou-workspace-LLVM-Trigger-build-upstream-linux-src-llvm-project/443a2c9d-aacc-445a-8879-2270a60f214d/scratchpad/mir-src.ll"
  target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128"
  target triple = "riscv64"

  declare i32 @f(i32)

  declare void @g()

  define void @loop_exit() {
  entry:
    br label %header

  header:                                           ; preds = %body, %entry
    %v = load volatile i32, ptr inttoptr (i64 16 to ptr), align 4
    %c = icmp eq i32 %v, 0
    br i1 %c, label %exit, label %body

  body:                                             ; preds = %header
    call void @g()
    br label %header

  exit:                                             ; preds = %header
    ret void
  }

  define i32 @separate(i32 %x, i32 %y) {
  entry:
    %c = icmp eq i32 %x, 0
    br i1 %c, label %a, label %b

  a:                                                ; preds = %entry
    %r1 = call i32 @f(i32 %y)
    br label %ret

  b:                                                ; preds = %entry
    %r2 = call i32 @f(i32 %x)
    %r3 = call i32 @f(i32 %y)
    %r4 = call i32 @f(i32 %r2)
    %s = add i32 %r3, %r4
    %s2 = add i32 %s, %y
    br label %ret

  ret:                                              ; preds = %b, %a
    %p = phi i32 [ %r1, %a ], [ %s2, %b ]
    ret i32 %p
  }

  define i32 @separate_split_edge(i32 %x, i32 %y) {
  entry:
    %c = icmp eq i32 %x, 0
    br i1 %c, label %s1, label %p

  p:                                                ; preds = %entry
    %r = call i32 @f(i32 %x)
    %c2 = icmp eq i32 %r, 0
    br i1 %c2, label %s1, label %s2

  s1:                                               ; preds = %p, %entry
    %v = phi i32 [ %x, %entry ], [ %r, %p ]
    %r1 = call i32 @f(i32 %v)
    ret i32 %r1

  s2:                                               ; preds = %p
    %r2 = call i32 @f(i32 %r)
    %s = add i32 %r2, %y
    ret i32 %s
  }
...
