; NOSEP-NEXT:    sd s0, 16(sp) # 8-byte Folded Spill
; NOSEP-NEXT:    sd s1, 8(sp) # 8-byte Folded Spill
; NOSEP-NEXT:    .cfi_offset ra, -8
