; Separate shrink-wrapping of callee-saved registers in RISCVShrinkWrap. The
; NOSEP checks show the code without it.

declare i32 @f(i32)
declare void @abort() noreturn nounwind
declare double @fd(double)

; All paths need the frame, but s0/s1/s2 are only used on one path. Separate
; shrink-wrapping saves and restores them only there.
define i32 @separate(i32 %x, i32 %y) {
;
; CHECK-LABEL: separate:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi sp, sp, -32
; CHECK-NEXT:    .cfi_def_cfa_offset 32
; CHECK-NEXT:    sd ra, 24(sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset ra, -8
; CHECK-NEXT:    sd s0, 16(sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset s0, -16
; CHECK-NEXT:    sext.w a2, a0
; CHECK-NEXT:    mv s0, a1
; CHECK-NEXT:    beqz a2, .LBB0_2
; CHECK-NEXT:  # %bb.1: # %b
; CHECK-NEXT:    sd s1, 8(sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset s1, -24
; CHECK-NEXT:    sd s2, 0(sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset s2, -32
; CHECK-NEXT:    call f
; CHECK-NEXT:    mv s1, a0
; CHECK-NEXT:    mv a0, s0
; CHECK-NEXT:    call f
; CHECK-NEXT:    mv s2, a0
; CHECK-NEXT:    mv a0, s1
; CHECK-NEXT:    call f
; CHECK-NEXT:    add s0, s2, s0
; CHECK-NEXT:    addw a0, s0, a0
; CHECK-NEXT:    ld s1, 8(sp) # 8-byte Folded Reload
; CHECK-NEXT:    .cfi_restore s1
; CHECK-NEXT:    ld s2, 0(sp) # 8-byte Folded Reload
; CHECK-NEXT:    .cfi_restore s2
; CHECK-NEXT:    j .LBB0_3
; CHECK-NEXT:  .LBB0_2: # %a
; CHECK-NEXT:    mv a0, s0
; CHECK-NEXT:    call f
; CHECK-NEXT:  .LBB0_3: # %ret
; CHECK-NEXT:    ld ra, 24(sp) # 8-byte Folded Reload
; CHECK-NEXT:    .cfi_restore ra
; CHECK-NEXT:    ld s0, 16(sp) # 8-byte Folded Reload
; CHECK-NEXT:    .cfi_restore s0
; CHECK-NEXT:    addi sp, sp, 32
; CHECK-NEXT:    .cfi_def_cfa_offset 0
; CHECK-NEXT:    ret
;
; NOSEP-LABEL: separate:
; NOSEP:       # %bb.0: # %entry
; NOSEP-NEXT:    addi sp, sp, -32
; NOSEP-NEXT:    .cfi_def_cfa_offset 32
; NOSEP-NEXT:    sd ra, 24(sp) # 8-byte Folded Spill
; NOSEP-NEXT:    sd s0, 16(sp) # 8-byte Folded Spill
; NOSEP-NEXT:    sd s1, 8(sp) # 8-byte Folded Spill
; NOSEP-NEXT:    sd s2, 0(sp) # 8-byte Folded Spill
; NOSEP-NEXT:    .cfi_offset ra, -8
; NOSEP-NEXT:    .cfi_offset s0, -16
; NOSEP-NEXT:    .cfi_offset s1, -24
; NOSEP-NEXT:    .cfi_offset s2, -32
; NOSEP-NEXT:    sext.w a2, a0
; NOSEP-NEXT:    mv s0, a1
; NOSEP-NEXT:    beqz a2, .LBB0_2
; NOSEP-NEXT:  # %bb.1: # %b
; NOSEP-NEXT:    call f
; NOSEP-NEXT:    mv s1, a0
; NOSEP-NEXT:    mv a0, s0
; NOSEP-NEXT:    call f
; NOSEP-NEXT:    mv s2, a0
; NOSEP-NEXT:    mv a0, s1
; NOSEP-NEXT:    call f
; NOSEP-NEXT:    add s0, s2, s0
; NOSEP-NEXT:    addw a0, s0, a0
; NOSEP-NEXT:    j .LBB0_3
; NOSEP-NEXT:  .LBB0_2: # %a
; NOSEP-NEXT:    mv a0, s0
; NOSEP-NEXT:    call f
; NOSEP-NEXT:  .LBB0_3: # %ret
; NOSEP-NEXT:    ld ra, 24(sp) # 8-byte Folded Reload
; NOSEP-NEXT:    ld s0, 16(sp) # 8-byte Folded Reload
; NOSEP-NEXT:    ld s1, 8(sp) # 8-byte Folded Reload
; NOSEP-NEXT:    ld s2, 0(sp) # 8-byte Folded Reload
; NOSEP-NEXT:    .cfi_restore ra
; NOSEP-NEXT:    .cfi_restore s0
; NOSEP-NEXT:    .cfi_restore s1
; NOSEP-NEXT:    .cfi_restore s2
; NOSEP-NEXT:    addi sp, sp, 32
; NOSEP-NEXT:    .cfi_def_cfa_offset 0
; NOSEP-NEXT:    ret
entry:
  %c = icmp eq i32 %x, 0
  br i1 %c, label %a, label %b
a:
  %r1 = call i32 @f(i32 %y)
  br label %ret
b:
  %r2 = call i32 @f(i32 %x)
  %r3 = call i32 @f(i32 %y)
  %r4 = call i32 @f(i32 %r2)
  %s = add i32 %r3, %r4
  %s2 = add i32 %s, %y
  br label %ret
ret:
  %p = phi i32 [%r1, %a], [%s2, %b]
  ret i32 %p
}

; The registers used in the loop are saved before it, not in it.
define i32 @separate_loop(i32 %n, i32 %x) {
;
; CHECK-LABEL: separate_loop:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi sp, sp, -32
; CHECK-NEXT:    .cfi_def_cfa_offset 32
; CHECK-NEXT:    sd ra, 24(sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset ra, -8
; CHECK-NEXT:    sext.w a1, a1
; CHECK-NEXT:    beqz a1, .LBB1_4
; CHECK-NEXT:  # %bb.1: # %preheader
; CHECK-NEXT:    sd s0, 16(sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset s0, -16
; CHECK-NEXT:    sd s1, 8(sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset s1, -24
; CHECK-NEXT:    sd s2, 0(sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset s2, -32
; CHECK-NEXT:    li s1, 0
; CHECK-NEXT:    li s0, 0
; CHECK-NEXT:    sext.w s2, a0
; CHECK-NEXT:  .LBB1_2: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    mv a0, s1
; CHECK-NEXT:    call f
; CHECK-NEXT:    addiw s1, s1, 1
; CHECK-NEXT:    addw s0, s0, a0
; CHECK-NEXT:    bne s2, s1, .LBB1_2
; CHECK-NEXT:  # %bb.3: # %exit
; CHECK-NEXT:    mv a0, s0
; CHECK-NEXT:    ld ra, 24(sp) # 8-byte Folded Reload
; CHECK-NEXT:    .cfi_restore ra
; CHECK-NEXT:    ld s0, 16(sp) # 8-byte Folded Reload
; CHECK-NEXT:    .cfi_restore s0
; CHECK-NEXT:    ld s1, 8(sp) # 8-byte Folded Reload
; CHECK-NEXT:    .cfi_restore s1
; CHECK-NEXT:    ld s2, 0(sp) # 8-byte Folded Reload
; CHECK-NEXT:    .cfi_restore s2
; CHECK-NEXT:    addi sp, sp, 32
; CHECK-NEXT:    .cfi_def_cfa_offset 0
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB1_4: # %fast
; CHECK-NEXT:    .cfi_def_cfa_offset 32
; CHECK-NEXT:    .cfi_offset ra, -8
; CHECK-NEXT:    call f
; CHECK-NEXT:    ld ra, 24(sp) # 8-byte Folded Reload
; CHECK-NEXT:    .cfi_restore ra
; CHECK-NEXT:    addi sp, sp, 32
; CHECK-NEXT:    .cfi_def_cfa_offset 0
; CHECK-NEXT:    ret
;
; NOSEP-LABEL: separate_loop:
; NOSEP:       # %bb.0: # %entry
; NOSEP-NEXT:    addi sp, sp, -32
; NOSEP-NEXT:    .cfi_def_cfa_offset 32
; NOSEP-NEXT:    sd ra, 24(sp) # 8-byte Folded Spill
; NOSEP-NEXT:    sd s0, 16(sp) # 8-byte Folded Spill
; NOSEP-NEXT:    sd s1, 8(sp) # 8-byte Folded Spill
; NOSEP-NEXT:    sd s2, 0(sp) # 8-byte Folded Spill
; NOSEP-NEXT:    .cfi_offset ra, -8
; NOSEP-NEXT:    .cfi_offset s0, -16
; NOSEP-NEXT:    .cfi_offset s1, -24
; NOSEP-NEXT:    .cfi_offset s2, -32
; NOSEP-NEXT:    sext.w a1, a1
; NOSEP-NEXT:    beqz a1, .LBB1_4
; NOSEP-NEXT:  # %bb.1: # %preheader
; NOSEP-NEXT:    li s1, 0
; NOSEP-NEXT:    li s0, 0
; NOSEP-NEXT:    sext.w s2, a0
; NOSEP-NEXT:  .LBB1_2: # %loop
; NOSEP-NEXT:    # =>This Inner Loop Header: Depth=1
; NOSEP-NEXT:    mv a0, s1
; NOSEP-NEXT:    call f
; NOSEP-NEXT:    addiw s1, s1, 1
; NOSEP-NEXT:    addw s0, s0, a0
; NOSEP-NEXT:    bne s2, s1, .LBB1_2
; NOSEP-NEXT:  # %bb.3: # %exit
; NOSEP-NEXT:    mv a0, s0
; NOSEP-NEXT:    j .LBB1_5
; NOSEP-NEXT:  .LBB1_4: # %fast
; NOSEP-NEXT:    call f
; NOSEP-NEXT:  .LBB1_5: # %exit
; NOSEP-NEXT:    ld ra, 24(sp) # 8-byte Folded Reload
; NOSEP-NEXT:    ld s0, 16(sp) # 8-byte Folded Reload
; NOSEP-NEXT:    ld s1, 8(sp) # 8-byte Folded Reload
; NOSEP-NEXT:    ld s2, 0(sp) # 8-byte Folded Reload
; NOSEP-NEXT:    .cfi_restore ra
; NOSEP-NEXT:    .cfi_restore s0
; NOSEP-NEXT:    .cfi_restore s1
; NOSEP-NEXT:    .cfi_restore s2
; NOSEP-NEXT:    addi sp, sp, 32
; NOSEP-NEXT:    .cfi_def_cfa_offset 0
; NOSEP-NEXT:    ret
entry:
  %c = icmp eq i32 %x, 0
  br i1 %c, label %fast, label %preheader
fast:
  %r0 = call i32 @f(i32 %n)
  ret i32 %r0
preheader:
  br label %loop
loop:
  %i = phi i32 [0, %preheader], [%inc, %loop]
  %acc = phi i32 [0, %preheader], [%acc2, %loop]
  %r = call i32 @f(i32 %i)
  %acc2 = add i32 %acc, %r
  %inc = add i32 %i, 1
  %done = icmp eq i32 %inc, %n
  br i1 %done, label %exit, label %loop
exit:
  ret i32 %acc2
}

