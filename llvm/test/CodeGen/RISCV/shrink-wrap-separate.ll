; In the tests below, all paths from the saves of s1 (or s0 in the last test)
; end in blocks that do not return, so there are no restores. Such registers
; are saved in the prologue, because PEI needs the saves and the restores in
; pairs.

; The function has no return block.
define void @separate_no_return_block(i32 %x, i32 %y) {
; CHECK-LABEL: separate_no_return_block:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi sp, sp, -32
; CHECK-NEXT:    .cfi_def_cfa_offset 32
; CHECK-NEXT:    sd ra, 24(sp) # 8-byte Folded Spill
; CHECK-NEXT:    sd s0, 16(sp) # 8-byte Folded Spill
; CHECK-NEXT:    sd s1, 8(sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset ra, -8
; CHECK-NEXT:    .cfi_offset s0, -16
; CHECK-NEXT:    .cfi_offset s1, -24
; CHECK-NEXT:    mv s0, a1
; CHECK-NEXT:    call f
; CHECK-NEXT:    sext.w a0, a0
; CHECK-NEXT:    beqz a0, .LBB6_3
; CHECK-NEXT:  # %bb.1: # %b
; CHECK-NEXT:    mv a0, s0
; CHECK-NEXT:    call f
; CHECK-NEXT:    mv s1, a0
; CHECK-NEXT:    call f
; CHECK-NEXT:    add s0, s1, s0
; CHECK-NEXT:    addw a0, a0, s0
; CHECK-NEXT:    beqz a0, .LBB6_3
; CHECK-NEXT:  # %bb.2: # %d
; CHECK-NEXT:    call f
; CHECK-NEXT:  .LBB6_3: # %a
; CHECK-NEXT:    call abort
;
; NOSEP-LABEL: separate_no_return_block:
; NOSEP:       # %bb.0: # %entry
; NOSEP-NEXT:    addi sp, sp, -32
; NOSEP-NEXT:    .cfi_def_cfa_offset 32
; NOSEP-NEXT:    sd ra, 24(sp) # 8-byte Folded Spill
; NOSEP-NEXT:    sd s0, 16(sp) # 8-byte Folded Spill
; NOSEP-NEXT:    sd s1, 8(sp) # 8-byte Folded Spill
; NOSEP-NEXT:    .cfi_offset ra, -8
; NOSEP-NEXT:    .cfi_offset s0, -16
; NOSEP-NEXT:    .cfi_offset s1, -24
; NOSEP-NEXT:    mv s0, a1
; NOSEP-NEXT:    call f
; NOSEP-NEXT:    sext.w a0, a0
; NOSEP-NEXT:    beqz a0, .LBB6_3
; NOSEP-NEXT:  # %bb.1: # %b
; NOSEP-NEXT:    mv a0, s0
; NOSEP-NEXT:    call f
; NOSEP-NEXT:    mv s1, a0
; NOSEP-NEXT:    call f
; NOSEP-NEXT:    add s0, s1, s0
; NOSEP-NEXT:    addw a0, a0, s0
; NOSEP-NEXT:    beqz a0, .LBB6_3
; NOSEP-NEXT:  # %bb.2: # %d
; NOSEP-NEXT:    call f
; NOSEP-NEXT:  .LBB6_3: # %a
; NOSEP-NEXT:    call abort
entry:
  %r1 = call i32 @f(i32 %x)
  %c1 = icmp eq i32 %r1, 0
  br i1 %c1, label %a, label %b
a:
  call void @abort()
  unreachable
b:
  %r2 = call i32 @f(i32 %y)
  %r3 = call i32 @f(i32 %r2)
  %s = add i32 %r3, %r2
  %s2 = add i32 %s, %y
  %c2 = icmp eq i32 %s2, 0
  br i1 %c2, label %c, label %d
c:
  call void @abort()
  unreachable
d:
  %r4 = call i32 @f(i32 %s2)
  call void @abort()
  unreachable
}

